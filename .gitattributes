# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.resx text eol=crlf
*.config text eol=crlf
*.manifest text eol=crlf
*.txt text eol=crlf

# Binary
*.ico binary
*.png binary
*.jpg binary
*.dll binary
*.exe binary